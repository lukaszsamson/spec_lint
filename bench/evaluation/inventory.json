{
  "schema": "spec_lint/evaluation_inventory",
  "version": 1,
  "frozen": "2026-09-29",
  "tool_revision_at_freeze": "62862e9",
  "document": "bench/evaluation/INVENTORY.md",
  "definitions": {
    "omission": "an MFA whose @spec return omits a value that a runtime call with arguments inside the declared argument types returns normally",
    "status": {
      "witnessed": "a committed, executable witness on the pinned library build calls the MFA with arguments inside the declared domain (checked against the cited type declarations) and the result is outside the declared return",
      "source-only": "a source path to an undeclared return is plausible but no in-domain runtime witness exists",
      "refuted": "an in-domain witness returned inside the declared return, or source review shows the alternative is unreachable for in-domain inputs"
    },
    "family_rule": [
      "all omitted alternatives of one MFA are one family, whatever the number of clauses, slices, inputs or findings (Absinthe.Blueprint.Input.parse/1's seven clause findings are one family)",
      "two MFAs are one family when the undeclared value that witnesses one is produced by the same source construct as the other's: one returns the other's result (delegation), or both relay a value built at one origin; the relation is closed transitively",
      "MFAs with separate code are separate families even when the defect has the same kind (two stale specs are two families)"
    ],
    "categories": {
      "return_value": "the returned value itself, or a component of it that is not a struct field, is outside the declared return",
      "struct_default": "a returned struct keeps a field at its default value, outside the field's declared type",
      "struct_field_from_input": "a returned struct field holds a value copied from an in-domain argument, outside the field's declared type"
    },
    "category_policy": "struct_default and struct_field_from_input families stay in the denominator; every recall figure is also reported for category return_value alone. The categories change no rule policy.",
    "counting_unit": "omission family",
    "denominator": "the number of families with status witnessed in this file",
    "numerator": {
      "gated": "at least one MFA of the family has a finding with rule SL001 and gate true in the product report of the family's corpus under the measured adapter",
      "reported": "not gated, and at least one MFA of the family has any finding (SL001 with gate false, or SL002) in that report",
      "silent": "no finding on any MFA of the family",
      "recall": "gated recall = gated / denominator; reported recall = (gated + reported) / denominator; both also for category return_value",
      "granularity": "a finding counts by its subject MFA, whatever its slice or clause"
    },
    "reports": "the committed product reports (*.spec_lint.json) of the corpus, default configuration, one set per adapter; a measurement names the set and its file hashes",
    "change_policy": "any change to families, statuses, witnesses, the family rule, the denominator or the holdout procedure is a new version of this file in its own commit, documented in INVENTORY.md; numbers computed against version 1 cite it"
  },
